<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Cyber 2048</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            touch-action: manipulation;
            user-select: none;
            -webkit-user-select: none;
        }

        /* Glassmorphism effects */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Tile Color Mapping & Neon Glows */
        .tile-2 { background: #1e293b; color: #f8fafc; border: 1px solid #334155; }
        .tile-4 { background: #0f172a; color: #38bdf8; border: 1px solid #0284c7; box-shadow: 0 0 10px rgba(56, 189, 248, 0.2); }
        .tile-8 { background: #172554; color: #60a5fa; border: 1px solid #2563eb; box-shadow: 0 0 12px rgba(96, 165, 250, 0.3); }
        .tile-16 { background: #311042; color: #c084fc; border: 1px solid #9333ea; box-shadow: 0 0 14px rgba(192, 132, 252, 0.35); }
        .tile-32 { background: #4c0519; color: #fb7185; border: 1px solid #e11d48; box-shadow: 0 0 16px rgba(251, 113, 133, 0.4); }
        .tile-64 { background: #451a03; color: #fb923c; border: 1px solid #ea580c; box-shadow: 0 0 18px rgba(251, 146, 60, 0.45); }
        .tile-128 { background: #422006; color: #facc15; border: 1px solid #ca8a04; box-shadow: 0 0 20px rgba(250, 204, 21, 0.5); }
        .tile-256 { background: #052e16; color: #4ade80; border: 1px solid #16a34a; box-shadow: 0 0 22px rgba(74, 222, 128, 0.55); }
        .tile-512 { background: #042f2e; color: #2dd4bf; border: 1px solid #0d9488; box-shadow: 0 0 24px rgba(45, 212, 191, 0.6); }
        .tile-1024 { background: #164e63; color: #22d3ee; border: 1px solid #0891b2; box-shadow: 0 0 28px rgba(34, 211, 238, 0.7); }
        .tile-2048 { background: linear-gradient(135deg, #a855f7, #ec4899); color: #ffffff; border: 1px solid #f472b6; box-shadow: 0 0 32px rgba(236, 72, 153, 0.8); }
        .tile-super { background: linear-gradient(135deg, #eab308, #ef4444); color: #ffffff; border: 1px solid #fde047; box-shadow: 0 0 36px rgba(250, 204, 21, 0.9); }

        /* Animation effects */
        .tile-spawn {
            animation: spawn 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .tile-merge {
            animation: merge 0.25s ease-in-out forwards;
        }

        @keyframes spawn {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes merge {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        /* Pulse glow for title */
        .neon-text-glow {
            text-shadow: 0 0 10px rgba(168, 85, 247, 0.6), 0 0 20px rgba(236, 72, 153, 0.4);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center justify-between p-4 overflow-x-hidden">

    <!-- Header Section -->
    <header class="w-full max-w-md flex flex-col gap-4 mt-2">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-500 to-rose-400 neon-text-glow">
                    2048
                </h1>
                <p class="text-xs text-slate-400 font-medium tracking-wide">CYBER EDITION</p>
            </div>

            <!-- Scoreboards -->
            <div class="flex gap-2">
                <div class="glass-panel px-4 py-2 rounded-xl flex flex-col items-center min-w-[75px]">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">SCORE</span>
                    <span id="current-score" class="text-lg font-extrabold text-purple-400">0</span>
                </div>
                <div class="glass-panel px-4 py-2 rounded-xl flex flex-col items-center min-w-[75px]">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">BEST</span>
                    <span id="high-score" class="text-lg font-extrabold text-amber-400">0</span>
                </div>
            </div>
        </div>

        <!-- Controls Toolbar -->
        <div class="flex items-center justify-between gap-2 glass-panel p-2 rounded-2xl">
            <button id="btn-restart" class="flex-1 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 py-2 px-3 rounded-xl font-semibold text-xs transition flex items-center justify-center gap-1.5 border border-slate-700">
                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                New Game
            </button>
            <button id="btn-undo" class="flex-1 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-200 py-2 px-3 rounded-xl font-semibold text-xs transition flex items-center justify-center gap-1.5 border border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
                Undo
            </button>
            <button id="btn-sound" class="p-2 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 rounded-xl transition border border-slate-700" title="Toggle Sound">
                <svg id="sound-icon-on" class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"></path></svg>
                <svg id="sound-icon-off" class="w-4 h-4 text-slate-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" clip-rule="evenodd"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>
            </button>
        </div>
    </header>

    <!-- Main Game Container -->
    <main class="relative w-full max-w-md aspect-square my-auto p-3 glass-panel rounded-3xl border border-slate-800 shadow-2xl flex flex-col justify-center">
        <!-- 4x4 Grid Background Cells -->
        <div id="grid-background" class="grid grid-cols-4 grid-rows-4 gap-3 w-full h-full">
            <!-- 16 Static Placeholders -->
            <script>
                for(let i=0; i<16; i++){
                    document.write('<div class="bg-slate-900/80 rounded-2xl border border-slate-800/60 w-full h-full"></div>');
                }
            </script>
        </div>

        <!-- Dynamic Tiles Container -->
        <div id="tile-container" class="absolute inset-0 p-3 grid grid-cols-4 grid-rows-4 gap-3 w-full h-full pointer-events-none">
            <!-- Tiles rendered dynamically via JS -->
        </div>

        <!-- Overlay Screen (Game Over / Victory) -->
        <div id="game-overlay" class="absolute inset-0 rounded-3xl bg-slate-950/90 backdrop-blur-md flex flex-col items-center justify-center gap-4 opacity-0 pointer-events-none transition-all duration-300 z-20">
            <h2 id="overlay-title" class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500 tracking-wider">
                GAME OVER
            </h2>
            <p id="overlay-msg" class="text-sm text-slate-400 font-medium">No more available moves left!</p>
            <div class="flex gap-3 mt-2">
                <button id="overlay-btn-keep" class="hidden bg-slate-800 hover:bg-slate-700 text-slate-200 py-2.5 px-5 rounded-xl font-bold text-xs border border-slate-700 transition">
                    Keep Going
                </button>
                <button id="overlay-btn-restart" class="bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white py-2.5 px-6 rounded-xl font-bold text-xs shadow-lg shadow-purple-500/25 transition active:scale-95">
                    Try Again
                </button>
            </div>
        </div>
    </main>

    <!-- Touch / Keyboard Prompt Footer -->
    <footer class="w-full max-w-md text-center py-2">
        <p class="text-xs text-slate-500 flex items-center justify-center gap-2">
            <span>Swipe or use <kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-[10px] text-slate-300">Arrow Keys</kbd> to play</span>
        </p>
    </footer>

    <!-- Logic Script -->
    <script>
        // Web Audio Synthesizer for SFX
        class AudioFX {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
            }

            playTone(freq, type = 'sine', duration = 0.1, gainVal = 0.1) {
                if (this.muted) return;
                this.init();
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }

                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);

                    gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start();
                    osc.stop(this.ctx.currentTime + duration);
                } catch(e) {}
            }

            move() { this.playTone(180, 'triangle', 0.05, 0.05); }
            merge(val) { 
                const baseFreq = 220;
                const freq = baseFreq + Math.log2(val) * 40;
                this.playTone(freq, 'sine', 0.15, 0.12); 
            }
            win() {
                setTimeout(() => this.playTone(440, 'sine', 0.15, 0.1), 0);
                setTimeout(() => this.playTone(554.37, 'sine', 0.15, 0.1), 100);
                setTimeout(() => this.playTone(659.25, 'sine', 0.3, 0.1), 200);
            }
            lose() {
                setTimeout(() => this.playTone(300, 'sawtooth', 0.2, 0.08), 0);
                setTimeout(() => this.playTone(220, 'sawtooth', 0.3, 0.08), 150);
            }
        }

        // Game State Management
        class Game2048 {
            constructor() {
                this.size = 4;
                this.board = Array(4).fill(null).map(() => Array(4).fill(0));
                this.score = 0;
                this.highScore = parseInt(localStorage.getItem('cyber2048_highscore')) || 0;
                this.won = false;
                this.keepPlaying = false;
                this.history = null;
                this.audio = new AudioFX();

                // UI Elements
                this.tileContainer = document.getElementById('tile-container');
                this.scoreEl = document.getElementById('current-score');
                this.highScoreEl = document.getElementById('high-score');
                this.overlay = document.getElementById('game-overlay');
                this.overlayTitle = document.getElementById('overlay-title');
                this.overlayMsg = document.getElementById('overlay-msg');
                this.btnKeep = document.getElementById('overlay-btn-keep');
                this.btnUndo = document.getElementById('btn-undo');

                this.init();
            }

            init() {
                this.highScoreEl.textContent = this.highScore;
                this.bindEvents();
                this.restart();
            }

            restart() {
                this.board = Array(4).fill(null).map(() => Array(4).fill(0));
                this.score = 0;
                this.won = false;
                this.keepPlaying = false;
                this.history = null;
                this.btnUndo.disabled = true;
                this.hideOverlay();
                this.updateScore(0);

                // Add 2 initial tiles
                this.addRandomTile();
                this.addRandomTile();
                this.render();
            }

            saveHistory() {
                this.history = {
                    board: JSON.parse(JSON.stringify(this.board)),
                    score: this.score,
                    won: this.won
                };
                this.btnUndo.disabled = false;
            }

            undo() {
                if (!this.history) return;
                this.board = JSON.parse(JSON.stringify(this.history.board));
                this.score = this.history.score;
                this.won = this.history.won;
                this.history = null;
                this.btnUndo.disabled = true;
                this.hideOverlay();
                this.updateScore(0);
                this.render();
            }

            addRandomTile() {
                const emptyCells = [];
                for (let r = 0; r < 4; r++) {
                    for (let c = 0; c < 4; c++) {
                        if (this.board[r][c] === 0) {
                            emptyCells.push({ r, c });
                        }
                    }
                }
                if (emptyCells.length > 0) {
                    const { r, c } = emptyCells[Math.floor(Math.random() * emptyCells.length)];
                    this.board[r][c] = Math.random() < 0.9 ? 2 : 4;
                    return { r, c };
                }
                return null;
            }

            updateScore(amount) {
                this.score += amount;
                this.scoreEl.textContent = this.score;
                if (this.score > this.highScore) {
                    this.highScore = this.score;
                    this.highScoreEl.textContent = this.highScore;
                    localStorage.setItem('cyber2048_highscore', this.highScore);
                }
            }

            move(direction) {
                // direction: 0: up, 1: right, 2: down, 3: left
                const previousBoard = JSON.stringify(this.board);
                let mergedAny = false;
                let maxMergedVal = 0;

                this.saveHistory();

                // Rotate board to simplify processing everything as sliding left
                for (let i = 0; i < direction; i++) {
                    this.board = this.rotateLeft(this.board);
                }

                // Slide & Merge Left
                for (let r = 0; r < 4; r++) {
                    let row = this.board[r].filter(val => val !== 0);
                    for (let c = 0; c < row.length - 1; c++) {
                        if (row[c] === row[c + 1]) {
                            row[c] *= 2;
                            this.updateScore(row[c]);
                            maxMergedVal = Math.max(maxMergedVal, row[c]);
                            mergedAny = true;
                            row.splice(c + 1, 1);
                        }
                    }
                    while (row.length < 4) row.push(0);
                    this.board[r] = row;
                }

                // Rotate back to original orientation
                for (let i = 0; i < (4 - direction) % 4; i++) {
                    this.board = this.rotateLeft(this.board);
                }

                const moved = previousBoard !== JSON.stringify(this.board);

                if (moved) {
                    if (mergedAny) {
                        this.audio.merge(maxMergedVal);
                    } else {
                        this.audio.move();
                    }

                    this.addRandomTile();
                    this.render();
                    this.checkGameState();
                } else {
                    // Undo history if no actual movement occurred
                    this.history = null;
                    this.btnUndo.disabled = true;
                }
            }

            rotateLeft(matrix) {
                const result = Array(4).fill(null).map(() => Array(4).fill(0));
                for (let r = 0; r < 4; r++) {
                    for (let c = 0; c < 4; c++) {
                        result[4 - 1 - c][r] = matrix[r][c];
                    }
                }
                return result;
            }

            checkGameState() {
                // Check Win
                if (!this.won && !this.keepPlaying) {
                    for (let r = 0; r < 4; r++) {
                        for (let c = 0; c < 4; c++) {
                            if (this.board[r][c] === 2048) {
                                this.won = true;
                                this.audio.win();
                                this.showOverlay("YOU WIN!", "You unlocked the legendary 2048 tile!", true);
                                return;
                            }
                        }
                    }
                }

                // Check Game Over
                if (!this.canMove()) {
                    this.audio.lose();
                    this.showOverlay("GAME OVER", "No available moves left on the grid.", false);
                }
            }

            canMove() {
                for (let r = 0; r < 4; r++) {
                    for (let c = 0; c < 4; c++) {
                        if (this.board[r][c] === 0) return true;
                        if (c < 3 && this.board[r][c] === this.board[r][c + 1]) return true;
                        if (r < 3 && this.board[r][c] === this.board[r + 1][c]) return true;
                    }
                }
                return false;
            }

            showOverlay(title, msg, showKeep) {
                this.overlayTitle.textContent = title;
                this.overlayMsg.textContent = msg;
                if (showKeep) {
                    this.btnKeep.classList.remove('hidden');
                } else {
                    this.btnKeep.classList.add('hidden');
                }
                this.overlay.classList.remove('opacity-0', 'pointer-events-none');
            }

            hideOverlay() {
                this.overlay.classList.add('opacity-0', 'pointer-events-none');
            }

            render() {
                this.tileContainer.innerHTML = '';
                for (let r = 0; r < 4; r++) {
                    for (let c = 0; c < 4; c++) {
                        const val = this.board[r][c];
                        if (val !== 0) {
                            const tile = document.createElement('div');
                            const tileStyleClass = val <= 2048 ? `tile-${val}` : 'tile-super';
                            
                            tile.className = `w-full h-full rounded-2xl flex items-center justify-center font-extrabold text-2xl transition-all duration-100 tile-spawn ${tileStyleClass}`;
                            
                            // Adjust font scale for larger digits
                            if (val >= 1024) tile.classList.add('text-xl');
                            if (val >= 10000) tile.classList.add('text-lg');

                            tile.textContent = val;
                            this.tileContainer.appendChild(tile);
                        } else {
                            // Empty placeholder for CSS grid alignment
                            const emptyNode = document.createElement('div');
                            this.tileContainer.appendChild(emptyNode);
                        }
                    }
                }
            }

            bindEvents() {
                // Keyboard inputs
                window.addEventListener('keydown', (e) => {
                    if (this.overlay.classList.contains('opacity-0')) {
                        switch (e.key) {
                            case 'ArrowUp': e.preventDefault(); this.move(0); break;
                            case 'ArrowRight': e.preventDefault(); this.move(1); break;
                            case 'ArrowDown': e.preventDefault(); this.move(2); break;
                            case 'ArrowLeft': e.preventDefault(); this.move(3); break;
                        }
                    }
                });

                // Swipe / Touch Controls
                let touchStartX = 0;
                let touchStartY = 0;
                const gameArea = document.querySelector('main');

                gameArea.addEventListener('touchstart', (e) => {
                    touchStartX = e.touches[0].clientX;
                    touchStartY = e.touches[0].clientY;
                }, { passive: true });

                gameArea.addEventListener('touchend', (e) => {
                    if (!touchStartX || !touchStartY) return;

                    const touchEndX = e.changedTouches[0].clientX;
                    const touchEndY = e.changedTouches[0].clientY;

                    const dx = touchEndX - touchStartX;
                    const dy = touchEndY - touchStartY;

                    // Minimum swipe distance threshold
                    if (Math.max(Math.abs(dx), Math.abs(dy)) > 30) {
                        if (Math.abs(dx) > Math.abs(dy)) {
                            // Horizontal Swipe
                            if (dx > 0) this.move(1); // Right
                            else this.move(3);        // Left
                        } else {
                            // Vertical Swipe
                            if (dy > 0) this.move(2); // Down
                            else this.move(0);        // Up
                        }
                    }

                    touchStartX = 0;
                    touchStartY = 0;
                }, { passive: true });

                // UI Button Listeners
                document.getElementById('btn-restart').addEventListener('click', () => this.restart());
                document.getElementById('overlay-btn-restart').addEventListener('click', () => this.restart());
                this.btnUndo.addEventListener('click', () => this.undo());
                
                this.btnKeep.addEventListener('click', () => {
                    this.keepPlaying = true;
                    this.hideOverlay();
                });

                // Sound toggle button
                const btnSound = document.getElementById('btn-sound');
                const soundOn = document.getElementById('sound-icon-on');
                const soundOff = document.getElementById('sound-icon-off');

                btnSound.addEventListener('click', () => {
                    this.audio.muted = !this.audio.muted;
                    if (this.audio.muted) {
                        soundOn.classList.add('hidden');
                        soundOff.classList.remove('hidden');
                    } else {
                        soundOn.classList.remove('hidden');
                        soundOff.classList.add('hidden');
                        this.audio.init();
                    }
                });
            }
        }

        // Boot Game when window loads
        window.onload = () => {
            new Game2048();
        };
    </script>
</body>
</html>
